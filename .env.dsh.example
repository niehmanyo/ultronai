# EXAMPLE ONLY: Never commit actual secrets.
OPENAI_API_KEY=replace_in_private_environment
OPENAI_MODEL=gpt-4.1-mini
ULTRON_ADMIN_PASSWORD=replace_with_16_or_more_random_characters
ULTRON_SESSION_SECRET=replace_with_32_or_more_random_characters
ULTRON_DSH_HOME=/var/lib/ultron-dsh
ULTRON_DSH_WORKSPACE=/var/lib/ultron-dsh/workspace
